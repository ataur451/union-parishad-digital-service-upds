{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://miniature-trout-5g4w6wqggjv63xvg-8000.app.github.dev/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

{
"version": 2,
"builds": [
{
"src": "backend/main.py",
"use": "@vercel/python"
},
{
"src": "frontend/package.json",
"use": "@vercel/static-build",
"config": {
"distDir": "dist"
}
}
],
"routes": [
{
"src": "/api/(.)",
"dest": "backend/main.py"
},
{
"src": "/(.)",
"dest": "frontend/$1"
}
]
}